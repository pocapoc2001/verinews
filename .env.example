# Optional: directory that receives the pipeline export (public/osint_output.json).
# Defaults to <repo>/public — set it when the dashboard is served from elsewhere.
# VERINEWS_PUBLIC_DIR="C:/path/to/public"

# Optional: Python interpreter used by the "Run live ingestion" API route.
# Defaults to .venv/Scripts/python.exe (Windows) or .venv/bin/python.
# VERINEWS_PYTHON=".venv/Scripts/python.exe"

# Optional: allow starting pipeline jobs from a non-localhost host (off by default).
# VERINEWS_ALLOW_RUN="1"
